<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
<LinearLayout android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="14dp" android:visibility="gone">
<TextView android:id="@+id/x1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Squad" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
<TextView android:id="@+id/x2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/w_none" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="4dp" android:gravity="center" />
<TextView android:id="@+id/x3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/w_none_hint" android:textColor="#B3FFFFFF" android:textSize="11sp" android:layout_marginTop="2dp" android:gravity="center" />
</LinearLayout>
<LinearLayout android:id="@+id/card" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="top" android:padding="16dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
