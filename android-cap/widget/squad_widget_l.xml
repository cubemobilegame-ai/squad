</LinearLayout></LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp">
<TextView android:id="@+id/btnNew" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center" android:background="@drawable/squad_btn" android:text="@string/w_new" android:textColor="#14141B" android:textSize="14sp" android:textStyle="bold" />
<TextView android:id="@+id/btnChat" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginLeft="8dp" android:gravity="center" android:background="@drawable/squad_pill" android:text="@string/w_chats" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
