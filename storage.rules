rules_version = '2';
// SQUAD – zdjęcia: profilowe (avatars/UID.jpg) i album wypadu (drops/KOD/UID_1..3.jpg)
service firebase.storage {
  match /b/{bucket}/o {
    function img(max) { return request.resource.size < max && request.resource.contentType.matches('image/.*'); }

    match /avatars/{file} {
      allow read: if true;
      allow create, update: if request.auth != null && file == request.auth.uid + '.jpg' && img(2 * 1024 * 1024);
      allow delete: if request.auth != null && file == request.auth.uid + '.jpg';
    }

    match /drops/{code}/{file} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && file.matches(request.auth.uid + '_[123][.]jpg') && img(3 * 1024 * 1024);
      allow delete: if request.auth != null && file.matches(request.auth.uid + '_.*');
    }
  }
}
