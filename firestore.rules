rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // „Moje dropy i grupy” na każdym urządzeniu: czytanie własnych wpisów przez zapytanie po polu uid
    match /{path=**}/participants/{pid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /{path=**}/members/{mid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    function signedIn() { return request.auth != null; }
    function isGuest() { return request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function drop(id) { return get(/databases/$(db)/documents/drops/$(id)).data; }
    function grp(id) { return get(/databases/$(db)/documents/groups/$(id)).data; }
    function is16() { return exists(/databases/$(db)/documents/users/$(request.auth.uid)) && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.get('pub16', false) == true; }
    function okNick(n) { return n is string && n.size() >= 1 && n.size() <= 20; }
    function okText(x) { return x is string && x.size() >= 1 && x.size() <= 500; }
    // reakcja: zmienia się tylko własny wpis w mapie r (r.<uid>), emoji z listy albo usunięcie
    function okReact() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['r'])
        && request.resource.data.get('r', {}).diff(resource.data.get('r', {})).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.get('r', {}))
            || request.resource.data.r[request.auth.uid] in ['🔥', '😂', '👀', '❤️', '👍', '😮']);
    }

    // głos w ankiecie: zmienia się tylko własny wpis w mapie v (v.<uid>) = numer odpowiedzi 0–5
    function okVote() {
      return resource.data.get('poll', null) != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['v'])
        && request.resource.data.get('v', {}).diff(resource.data.get('v', {})).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.get('v', {}))
            || (request.resource.data.v[request.auth.uid] is int && request.resource.data.v[request.auth.uid] >= 0 && request.resource.data.v[request.auth.uid] <= 5));
    }

    // profil (ksywka, awatar, odznaki, ustawienia powiadomień) – widoczny tylko dla właściciela
    match /users/{uid} {
      allow read, create, delete: if signedIn() && request.auth.uid == uid;
      // ksywkę można zmienić raz na 14 dni (pierwsze ustawienie zawsze)
      allow update: if signedIn() && request.auth.uid == uid && (
        !('nick' in request.resource.data) || !('nick' in resource.data) || request.resource.data.nick == resource.data.nick
        || (request.resource.data.get('nickAt', null) == request.time
            && (!('nickAt' in resource.data) || request.time > resource.data.nickAt + duration.value(14, 'd'))));
      // tokeny powiadomień push (jeden dokument na telefon)
      match /tokens/{tok} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      // KONTAKTY: obie strony dopisują się sobie nawzajem tylko gdy istnieje zaproszenie (creq/<od>_<do>); bez podglądu profili i DM
      match /contacts/{cid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && !isGuest() && okNick(request.resource.data.nickname) && (
          (request.auth.uid == uid && exists(/databases/$(db)/documents/creq/$(cid + '_' + uid)))
          || (request.auth.uid == cid && exists(/databases/$(db)/documents/creq/$(uid + '_' + cid))));
        // właściciel listy albo sam kontakt (tylko swoja ksywka / awatar / zdjęcie)
        allow update: if signedIn() && okNick(request.resource.data.nickname) && (request.auth.uid == uid
          || (request.auth.uid == cid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'av', 'ph'])));
        allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == cid);
      }
      // ALARM zaufanej osoby (przycisk bezpieczeństwa): czyta i kasuje odbiorca; tworzy tylko ktoś z jego kontaktów, tylko swój alert
      match /alerts/{aid} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && !isGuest()
          && request.resource.data.from == request.auth.uid
          && request.resource.data.kind == 'sos'
          && request.resource.data.at == request.time
          && request.resource.data.keys().hasOnly(['from', 'nick', 'av', 'code', 'title', 'place', 'drop', 'loc', 'people', 'kind', 'at'])
          && request.resource.data.get('title', '').size() <= 120
          && request.resource.data.get('place', '').size() <= 160
          && request.resource.data.get('people', []).size() <= 12
          && exists(/databases/$(db)/documents/users/$(uid)/contacts/$(request.auth.uid));
      }
      // zaproszenia na drop / do grupy – wysyła tylko ktoś z moich kontaktów
      match /invites/{iid} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && !isGuest()
          && request.resource.data.from == request.auth.uid
          && exists(/databases/$(db)/documents/users/$(uid)/contacts/$(request.auth.uid))
          && request.resource.data.kind in ['d', 'g']
          && iid == request.resource.data.kind + '_' + request.resource.data.code;
      }
    }

    // DROPY: link działa do startu eventu, wiadomości do 24h po evencie, potem dokument znika
    match /drops/{code} {
      allow get: if resource.data.expiresAt > request.time;
      allow list: if signedIn() && (resource.data.hostId == request.auth.uid || resource.data.get('public', false) == true);
      allow create: if signedIn() && !isGuest()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.expiresAt > request.time
        && request.resource.data.title.size() <= 60
        // publiczny drop tylko od osoby, która potwierdziła wiek 16+
        && (request.resource.data.get('public', false) != true || is16());
      allow update, delete: if signedIn() && resource.data.hostId == request.auth.uid;

      match /participants/{uid} {
        allow read: if drop(code).expiresAt > request.time;
        allow create, update: if signedIn() && request.auth.uid == uid
          && drop(code).startsAt > request.time
          && (drop(code).get('public', false) != true || drop(code).hostId == uid || is16())
          && !('id' in request.resource.data)
          && request.resource.data.status in ['in', 'late', 'out']
          && okNick(request.resource.data.nickname);
        // po starcie: tylko "przeczytane", "pisze…" i aktualna ksywka / awatar / zdjęcie
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'typing', 'nickname', 'av', 'ph'])
          && okNick(request.resource.data.nickname);
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // czat dropa: tylko uczestnicy, zero DM
      match /messages/{m} {
        allow read: if signedIn() && drop(code).expiresAt > request.time
          && exists(/databases/$(db)/documents/drops/$(code)/participants/$(request.auth.uid));
        allow create: if signedIn() && drop(code).expiresAt > request.time
          && exists(/databases/$(db)/documents/drops/$(code)/participants/$(request.auth.uid))
          && (drop(code).hostId == request.auth.uid
              || get(/databases/$(db)/documents/drops/$(code)/participants/$(request.auth.uid)).data.status in ['in', 'late'])
          && request.resource.data.authorId == request.auth.uid
          && !('r' in request.resource.data) && request.resource.data.get('v', {}).size() == 0
          && okText(request.resource.data.text);
        allow update: if signedIn() && drop(code).expiresAt > request.time
          && exists(/databases/$(db)/documents/drops/$(code)/participants/$(request.auth.uid))
          && (okReact() || okVote());
      }

      // ALBUM WYPADU: po starcie, każdy uczestnik max 3 zdjęcia (id = uid_1..3, zdjęcie zapisane w dokumencie), znika z dropem
      match /photos/{pid} {
        allow read: if signedIn() && drop(code).expiresAt > request.time
          && exists(/databases/$(db)/documents/drops/$(code)/participants/$(request.auth.uid));
        allow create: if signedIn() && drop(code).startsAt <= request.time && drop(code).expiresAt > request.time
          && exists(/databases/$(db)/documents/drops/$(code)/participants/$(request.auth.uid))
          && pid in [request.auth.uid + '_1', request.auth.uid + '_2', request.auth.uid + '_3']
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.url is string && request.resource.data.url.size() < 400000;
        allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || drop(code).hostId == request.auth.uid);
      }
    }

    // ZAPROSZENIA DO KONTAKTÓW: id = <od>_<do>
    match /creq/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn() && !isGuest()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && okNick(request.resource.data.nickname);
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // STATUS aplikacji (przerwa techniczna / awaria) – czytają wszyscy, zmienia tylko konsola / automat
    match /meta/status {
      allow get: if true;
    }

    // ZGŁOSZENIA (wiadomość / drop / grupa) – tylko zapis, czyta je moderacja w konsoli
    match /reports/{r} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reason in ['hate', 'sex', 'vio', 'danger', 'spam', 'other'];
    }

    // LISTA „POWIADOM MNIE O PREMIERZE” (strona getsquad.web.app) – tylko zapis, bez odczytu. Jednorazowy e-mail w dniu startu wysyła serwer.
    match /waitlist/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'lang', 'consent', 'at', 'sent'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$')
        && request.resource.data.lang in ['pl', 'en']
        && request.resource.data.consent == true
        && request.resource.data.at == request.time
        && request.resource.data.sent == false;
    }

    // GRUPY ogólne: stałe ekipy z własnym czatem, wchodzi się linkiem
    match /groups/{g} {
      allow get: if true;
      allow list: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && !isGuest()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name.size() <= 40;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /members/{uid} {
        allow read: if true;
        allow create, update: if signedIn() && request.auth.uid == uid && okNick(request.resource.data.nickname)
          && !('id' in request.resource.data) && exists(/databases/$(db)/documents/groups/$(g));
        allow delete: if signedIn() && (request.auth.uid == uid || grp(g).ownerId == request.auth.uid);
      }

      match /messages/{m} {
        allow delete: if signedIn() && grp(g).ownerId == request.auth.uid;
        allow read: if signedIn() && exists(/databases/$(db)/documents/groups/$(g))
          && exists(/databases/$(db)/documents/groups/$(g)/members/$(request.auth.uid));
        allow create: if signedIn() && exists(/databases/$(db)/documents/groups/$(g))
          && exists(/databases/$(db)/documents/groups/$(g)/members/$(request.auth.uid))
          && request.resource.data.authorId == request.auth.uid
          && !('r' in request.resource.data) && request.resource.data.get('v', {}).size() == 0
          && okText(request.resource.data.text);
        allow update: if signedIn()
          && exists(/databases/$(db)/documents/groups/$(g)/members/$(request.auth.uid))
          && (okReact() || okVote());
      }
    }
  }
}
