{
  "appId": "com.cubemobilegames.squad",
  "appName": "Squad",
  "webDir": "www",
  "backgroundColor": "#0b0b12",
  "server": {
    "url": "https://squad-64cd5.web.app",
    "allowNavigation": [
      "squad-64cd5.web.app",
      "squad-64cd5.firebaseapp.com",
      "getsquad.web.app"
    ]
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false,
    "backgroundColor": "#0b0b12"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com",
        "apple.com",
        "facebook.com"
      ]
    },
    "FirebaseMessaging": {
      "presentationOptions": [
        "alert",
        "badge",
        "sound"
      ]
    },
    "Keyboard": {
      "resize": "none"
    }
  }
}